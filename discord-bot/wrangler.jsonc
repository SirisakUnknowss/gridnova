{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gridnova-discord-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Discord's message events only arrive over the Gateway WebSocket, so one
  // Durable Object holds that connection open. The cron re-opens it if
  // Cloudflare evicts the object (deploys, restarts).
  "durable_objects": {
    "bindings": [{ "name": "GATEWAY", "class_name": "GatewayBot" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatewayBot"] }],
  "triggers": { "crons": ["*/5 * * * *"] },

  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  "vars": {
    // Comma-separated channel IDs where the bot answers every message.
    "HELP_CHANNEL_IDS": "",
    // Optional: channel the bot points players to for bugs / account issues.
    "BUG_REPORT_CHANNEL_ID": "",
    "CLAUDE_MODEL": "claude-opus-5-5",
    // Hard cap on Claude calls per UTC day, so a spam wave can't run up the bill.
    "MAX_DAILY_REPLIES": "400"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   DISCORD_BOT_TOKEN, ANTHROPIC_API_KEY, ADMIN_TOKEN
}
